# Set LLM_PROVIDER=fake to run without an external LLM (the test default).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=your_gemini_api_key_here
LLM_API_KEY=your_api_key_here
LLM_CONFIDENCE_THRESHOLD=0.70

EXECUTION_MODE=simulator

# For Razorpay Test Mode integration (do NOT use production credentials):
# EXECUTION_MODE=razorpay_test
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=test_key_id_here
RAZORPAY_KEY_SECRET=test_key_secret_here

DATABASE_PATH=recoverai.db
